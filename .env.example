# =============================================================================
# 环境变量模板：将本文件复制为 .env 并填入真实值，切勿将 .env 提交到版本库。
# 代码中所有密钥均通过 os.environ 读取，未配置时使用下方占位符（不会泄漏真实凭证）。
# =============================================================================

# ----- 大语言模型 API（OpenAI 兼容接口）-----
# 阿里云百炼（Qwen，qwen-turbo）
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek（deepseek-v4-pro）
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI（GPT-3.5 / GPT-4o，可替换为任意中转地址）
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_BASE_URL=https://api.openai-proxy.org/v1

# ----- 向量数据库 Milvus / Zilliz Cloud -----
MILVUS_CLUSTER_ENDPOINT=YOUR_MILVUS_ENDPOINT
MILVUS_TOKEN=YOUR_MILVUS_TOKEN
